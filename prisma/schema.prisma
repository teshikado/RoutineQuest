generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Category {
  FITNESS
  LEARNING
  HEALTH
  PRODUCTIVITY
  HOUSEHOLD
  RELAXATION
  PERSONAL_GOALS
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum NotificationType {
  ROUTINE_REMINDER
  STREAK_AT_RISK
  GROUP_INVITE
  LEVEL_UP
  RANK_UP
  WEEKLY_REPORT
  GROUP_ROUTINE_ADDED
  GROUP_ROUTINE_CHAMPION
}

enum ParticipationStatus {
  PENDING
  JOINED
  DECLINED
  LEFT
}

enum GroupRoutineStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum GroupRoutineVisibility {
  ALL_MEMBERS
  PARTICIPANTS_ONLY
}

enum GroupRoutineGoalType {
  NONE
  WEEKLY
}

enum GroupRoutineAwardType {
  CHAMPION
  STREAK_MEISTER
  COMEBACK_STAR
  TEAMPLAYER
  PERFECT_WOCHE
}

// ---------- Day planning ----------

enum DayPlanRecurrenceType {
  SINGLE_DAY
  EVERY_DAY
  WEEKDAYS
  WEEKEND
  CUSTOM_DAYS
}

enum DayPlanEntryCategory {
  WORK
  TRADING
  LEARNING
  SPORT
  HEALTH
  LEISURE
  BREAK
  APPOINTMENT
  HOUSEHOLD
  SLEEP
  PERSONAL
  OTHER
}

enum DayPlanEntryPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum DayPlanEntryStatus {
  PLANNED
  IN_PROGRESS
  DONE
  SKIPPED
  MOVED
}

enum DayReviewMood {
  GREAT
  GOOD
  OKAY
  HARD
  BAD
}

// ---------- Core user ----------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  username       String?  @unique
  avatarEmoji    String   @default("🙂")
  avatarColor    String   @default("#4FA8D8")
  onboarded      Boolean  @default(false)
  totalXp        Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime? @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  routines           Routine[]
  completions        Completion[]
  xpTransactions     XpTransaction[]
  ownedGroups        Group[]              @relation("GroupOwner")
  groupMemberships   GroupMember[]
  sentInvites        GroupInvite[]        @relation("InviteCreator")
  userBadges         UserBadge[]
  notifications      Notification[]
  notificationPrefs  NotificationSetting[]
  passwordResetTokens PasswordResetToken[]
  createdGroupRoutines      GroupRoutine[]            @relation("GroupRoutineCreator")
  groupRoutineParticipations GroupRoutineParticipant[]
  groupRoutineCompletions   GroupRoutineCompletion[]
  groupRoutineAwards        GroupRoutineAward[]
  xpForDayPlanning   Boolean  @default(false)
  dayPlans           DayPlan[]
  dayPlanEntries     DayPlanEntry[]
  dayPlanTemplates   DayPlanTemplate[]
  dayReviews         DayReview[]

  @@index([email])
  @@index([username])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Routines ----------

model Routine {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  category    Category
  icon        String     @default("Sparkles")
  color       String     @default("#4FA8D8")
  difficulty  Difficulty @default(MEDIUM)
  scheduledDays Int[]    // 1 = Monday ... 7 = Sunday
  timeOfDay   String?    // "HH:mm"
  reminderEnabled Boolean @default(false)
  archived    Boolean    @default(false)
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions Completion[]
  dayPlanEntries DayPlanEntry[]

  @@index([userId])
  @@index([userId, archived])
}

model Completion {
  id          String   @id @default(cuid())
  routineId   String
  userId      String
  date        DateTime @db.Date
  xpAwarded   Int
  createdAt   DateTime @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([userId, date])
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // TASK_COMPLETE | DAILY_COMPLETE | STREAK_MILESTONE | PERFECT_WEEK
  refDate   DateTime @db.Date
  refId     String   @default("") // completionId for TASK_COMPLETE, "daily" / weekKey otherwise
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refDate, refId])
  @@index([userId, createdAt])
}

// ---------- Groups ----------

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("Users")
  color       String   @default("#4FA8D8")
  ownerId     String
  maxMembers  Int?
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members    GroupMember[]
  invites    GroupInvite[]
  groupRoutines GroupRoutine[]

  @@index([ownerId])
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  code      String    @unique
  createdById String
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int       @default(0)
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([groupId])
}

model Badge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String
  color       String   @default("#FFD166")

  userBadges UserBadge[]
}

model UserBadge {
  id            String    @id @default(cuid())
  userId        String
  badgeId       String
  groupRoutineId String?
  earnedAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge        Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  groupRoutine GroupRoutine? @relation(fields: [groupRoutineId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId, groupRoutineId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model NotificationSetting {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  enabled Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// ---------- Group routines ----------

model GroupRoutine {
  id          String                 @id @default(cuid())
  groupId     String
  createdById String
  title       String
  description String?
  category    Category
  icon        String                 @default("Sparkles")
  color       String                 @default("#4FA8D8")
  difficulty  Difficulty             @default(MEDIUM)
  xpReward    Int
  startDate   DateTime               @db.Date
  endDate     DateTime?              @db.Date
  scheduledDays Int[] // 1 = Monday ... 7 = Sunday
  timeOfDay   String?                // "HH:mm"
  visibility  GroupRoutineVisibility @default(ALL_MEMBERS)
  mandatory   Boolean                @default(false)
  goalType    GroupRoutineGoalType   @default(NONE)
  goalTarget  Int?
  status      GroupRoutineStatus     @default(ACTIVE)
  pausedAt    DateTime?
  endedAt     DateTime?
  deletedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  group       Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User                      @relation("GroupRoutineCreator", fields: [createdById], references: [id])
  participants GroupRoutineParticipant[]
  completions GroupRoutineCompletion[]
  awards      GroupRoutineAward[]
  userBadges  UserBadge[]
  dayPlanEntries DayPlanEntry[]

  @@index([groupId])
  @@index([groupId, status])
}

model GroupRoutineParticipant {
  id             String              @id @default(cuid())
  groupRoutineId String
  userId         String
  status         ParticipationStatus @default(PENDING)
  respondedAt    DateTime?
  joinedAt       DateTime?
  leftAt         DateTime?
  currentStreak  Int                 @default(0)
  longestStreak  Int                 @default(0)
  createdAt      DateTime            @default(now())

  groupRoutine GroupRoutine @relation(fields: [groupRoutineId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupRoutineId, userId])
  @@index([userId])
}

model GroupRoutineCompletion {
  id             String   @id @default(cuid())
  groupRoutineId String
  userId         String
  date           DateTime @db.Date
  xpAwarded      Int
  createdAt      DateTime @default(now())

  groupRoutine GroupRoutine @relation(fields: [groupRoutineId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupRoutineId, userId, date])
  @@index([userId, date])
  @@index([groupRoutineId, date])
}

model GroupRoutineAward {
  id             String                @id @default(cuid())
  groupRoutineId String
  weekKey        String
  userId         String
  type           GroupRoutineAwardType
  meta           Json?
  createdAt      DateTime              @default(now())

  groupRoutine GroupRoutine @relation(fields: [groupRoutineId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupRoutineId, weekKey, type, userId])
  @@index([groupRoutineId, weekKey])
}

// ---------- Day planning ----------
// A DayPlan is a named plan over a date range (e.g. "Trading-Woche") that can generate many
// DayPlanEntry rows according to a recurrence rule. DayPlanEntry rows are the actual visible
// time blocks and are fully materialized (not computed on the fly), so editing/deleting a
// single occurrence, or "this and following", never has to reconstruct history. Entries
// created together (by a DayPlan's recurrence or a template application) share a `seriesId`
// so scoped edits ("this / this and following / all") can select the right rows. Entries are
// intentionally separate from Routine/Completion — a DayPlan entry is a scheduled plan item,
// not a recurring habit, and only awards XP if explicitly linked to a Routine/GroupRoutine or
// if the user opted into "XP für Tagesplanung".

model DayPlan {
  id              String                @id @default(cuid())
  userId          String
  title           String
  description     String?
  startDate       DateTime              @db.Date
  endDate         DateTime              @db.Date
  timeZone        String                @default("Europe/Berlin")
  color           String                @default("#A855F7")
  icon            String                @default("CalendarClock")
  recurrenceType  DayPlanRecurrenceType @default(SINGLE_DAY)
  recurrenceDays  Int[]                 // 1 = Monday ... 7 = Sunday, used when recurrenceType = CUSTOM_DAYS
  reminderMinutes Int?
  archived        Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries DayPlanEntry[]

  @@index([userId])
  @@index([userId, startDate, endDate])
}

model DayPlanEntry {
  id                   String               @id @default(cuid())
  userId               String
  dayPlanId            String?
  seriesId             String?
  title                String
  description          String?
  date                 DateTime             @db.Date // start day
  endDate              DateTime             @db.Date // end day -- equal to `date` for same-day blocks, later for blocks that cross midnight
  startTime            String               // "HH:mm", local wall-clock time in the plan's timeZone
  endTime              String               // "HH:mm"
  sortOrder            Int                  @default(0)
  category             DayPlanEntryCategory @default(OTHER)
  priority             DayPlanEntryPriority @default(NORMAL)
  status               DayPlanEntryStatus   @default(PLANNED)
  color                String               @default("#A855F7")
  icon                 String               @default("Clock")
  location             String?
  link                 String?
  notes                String?
  reminderMinutes      Int?
  linkedRoutineId      String?
  linkedGroupRoutineId String?
  moveReason           String?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayPlan            DayPlan?      @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  linkedRoutine      Routine?      @relation(fields: [linkedRoutineId], references: [id], onDelete: SetNull)
  linkedGroupRoutine GroupRoutine? @relation(fields: [linkedGroupRoutineId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, endDate])
  @@index([dayPlanId])
  @@index([seriesId])
}

model DayPlanTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#A855F7")
  icon        String   @default("LayoutTemplate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries DayPlanTemplateEntry[]

  @@index([userId])
}

model DayPlanTemplateEntry {
  id              String               @id @default(cuid())
  templateId      String
  title           String
  description     String?
  startTime       String
  endTime         String
  category        DayPlanEntryCategory @default(OTHER)
  priority        DayPlanEntryPriority @default(NORMAL)
  color           String               @default("#A855F7")
  icon            String               @default("Clock")
  location        String?
  link            String?
  notes           String?
  reminderMinutes Int?
  sortOrder       Int                  @default(0)

  template DayPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model DayReview {
  id        String          @id @default(cuid())
  userId    String
  date      DateTime        @db.Date
  mood      DayReviewMood?
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
